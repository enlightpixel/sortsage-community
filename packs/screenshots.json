{
  "format": "sortsage-rules",
  "version": 1,
  "rules": [
    {
      "id": "screenshots-1",
      "name": "Screenshot PNGs",
      "group": "Screenshots",
      "enabled": false,
      "auto_trigger": false,
      "match_mode": "All",
      "continue_processing": false,
      "allow_advanced_actions": false,
      "conditions": [
        {
          "NameStartsWith": "Screenshot"
        },
        {
          "ExtensionIs": "png"
        }
      ],
      "actions": [
        {
          "CopyTo": [
            "C:\\SortSage-Review\\Screenshots",
            "SmartRename"
          ]
        }
      ]
    }
  ]
}
